# Alpvefit ortam değişkenleri — Alpeptit'ten TAMAMEN AYRI değerler kullanın. Gerçek değerleri depoya koymayın.
NODE_ENV=production
PORT=4000
# Kendi PostgreSQL servisi (Railway'de alpvefit projesindeki Postgres)
DATABASE_URL=
# En az 32 karakter, birbirinden FARKLI ve Alpeptit'te kullanılanlardan FARKLI rastgele değerler
JWT_SECRET=
ENCRYPTION_KEY=
FRONTEND_URL=https://www.alpvefit.com
JWT_EXPIRES_IN=7d
# reCAPTCHA (alpvefit.com için AYRI anahtar çifti)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# E-posta (alpvefit.com alan adı için)
MAIL_FROM="Alpvefit <no-reply@alpvefit.com>"
RESEND_API_KEY=
# veya SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS
# Cloudflare arkasında gerçek ziyaretçi IP'si
TRUST_CLOUDFLARE=true

# --- Ödeme: yalnız sanal POS (kart). Kart verisi bu sunucuya uğramaz. ---
# Test aşaması: sahte (deneme) sanal POS. Üretimde yalnız ALLOW_MOCK_PAYMENTS=true ile açılır; GERÇEK sağlayıcıya geçince kaldırın.
PAYMENT_PROVIDER=mock
ALLOW_MOCK_PAYMENTS=true
# Ödeme penceresi (saat, varsayılan 2)
PAYMENT_WINDOW_HOURS=2
# Veritabanı TLS: Postgres sağlayıcısının kök CA sertifikası (PEM)
DB_CA_CERT=
# Koç Asistanı (isteğe bağlı): OpenAI uyumlu /chat/completions sunan herhangi bir sağlayıcı. Üçü de doluysa açılır; boşsa kapalıdır.
# Üye verisi yalnız üyenin açık rızasıyla gönderilir. Anahtarı yalnız sunucu ortam değişkeni olarak girin.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# AI_ENABLED=0 ile geçici olarak kapatılır; AI_DAILY_LIMIT tüm site için günlük yanıt sınırı (varsayılan 1000)
AI_ENABLED=
AI_DAILY_LIMIT=
